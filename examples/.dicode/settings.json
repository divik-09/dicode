{
  "permissions": {
    "allow": [
      "Bash(npm test:*)",
      "Bash(npm run lint:*)",
      "Bash(npx tsc:*)"
    ],
    "ask": [
      "Bash(git push:*)"
    ],
    "deny": [
      "Read(.env)",
      "Read(.env.*)",
      "Edit(.env*)",
      "Bash(rm -rf:*)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|MultiEdit|Write",
        "command": "sh .dicode/hooks/format.sh"
      }
    ],
    "Stop": [
      {
        "command": "npm test --silent >/dev/null 2>&1 || { echo 'Tests are failing. Fix them before finishing.' >&2; exit 2; }"
      }
    ]
  }
}
